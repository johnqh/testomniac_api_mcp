{
  "name": "@sudobility/testomniac_api_mcp",
  "version": "0.2.1",
  "description": "MCP server for the Testomniac API - allows AI assistants to interact with test automation data",
  "type": "module",
  "license": "BUSL-1.1",
  "publishConfig": {
    "access": "public"
  },
  "bin": {
    "testomniac-mcp": "./dist/index.js"
  },
  "scripts": {
    "dev": "bun run src/index.ts",
    "build": "bun build src/index.ts --outdir dist --target bun --minify",
    "typecheck": "tsc --noEmit",
    "start": "bun run dist/index.js"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "zod": "^4.4.3"
  }
}
